# Local infrastructure (docker-compose.yml). Copy to .env (git-ignored) or run `pnpm env:init`.
# Every variable has the same default inside docker-compose.yml, so this file is optional;
# change a value only to avoid a port conflict or to rename the local database.
# Local development only: none of these values is used in Azure.

# --- PostgreSQL 16 ---
# If you change these, update DATABASE_URL in apps/api/.env to match.
POSTGRES_USER=iconbridge
POSTGRES_PASSWORD=iconbridge
POSTGRES_DB=iconbridge
POSTGRES_PORT=5432

# --- Azurite (Azure Blob Storage emulator) ---
AZURITE_BLOB_PORT=10000

# --- Mailpit (catches all outgoing email) ---
# Host SMTP port the API sends to, and the web inbox: http://localhost:8025
# 2525 instead of the usual 1025: Windows reserves ports 1024-1123 on this workstation
# (Hyper-V exclusion range), so Docker Desktop cannot publish 1025.
MAILPIT_SMTP_PORT=2525
MAILPIT_UI_PORT=8025

# --- pgAdmin (optional: docker compose --profile tools up -d) ---
# UI: http://localhost:5050
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@iconbridge.dev
PGADMIN_PASSWORD=admin
