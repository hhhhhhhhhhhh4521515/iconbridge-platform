# Web app configuration. Copy to apps/web/.env (git-ignored) or run `pnpm env:init`.
# Validated with zod in src/lib/env-schema.ts: `next dev` and `next build` fail if a variable is missing.
# NEXT_PUBLIC_* values are embedded in the browser bundle: never put a secret here.

# Address of the API as the web SERVER reaches it (never sent to the browser).
# The browser only calls /api/v1/* on the web origin; src/proxy.ts forwards those
# calls here, so session cookies stay same-origin. Read at run time.
# Locally: the API on port 4000. In Azure: the internal address of the API container app.
API_INTERNAL_URL=http://localhost:4000

# Public address of the site, without a trailing slash. Used for canonical links,
# hreflang tags, sitemap.xml and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key for the contact and job-alert forms.
# The value below is Cloudflare's public test key: the site then skips the widget
# and the API (with its test secret) accepts the form. Use a real key in Azure.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
