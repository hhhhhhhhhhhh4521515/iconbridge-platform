// Data model of IconBridge Jobs (see docs/SPEC.md and the ER diagram in docs/ARCHITECTURE.md).
// The connection URL comes from prisma.config.ts.
//
// Conventions:
// - UUID primary keys generated by PostgreSQL, snake_case tables and columns, timestamptz.
// - Enum values mirror packages/shared (checked by src/prisma/enums.spec.ts).
// - CHECK constraints and the generated full-text column of `jobs` are written by hand in
//   the migration SQL: Prisma cannot express them, and does not report them as drift.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CANDIDATE
  VIEWER
  COUNTRY_AGENT
  RECRUITER
  SUPER_ADMIN
  /// Login of a partner company: its partner space only (ADR-027).
  PARTNER

  @@map("user_role")
}

enum PartnerMemberKind {
  /// A back-office account added by a super admin.
  STAFF
  /// A login of the partner company (role PARTNER), in exactly one space.
  PARTNER

  @@map("partner_member_kind")
}

enum PartnerJobStatus {
  OPEN
  CLOSED

  @@map("partner_job_status")
}

enum PartnerVisaStatus {
  NOT_STARTED
  APPOINTMENT_BOOKED
  SUBMITTED
  APPROVED
  REFUSED

  @@map("partner_visa_status")
}

enum PartnerWorkPermitStatus {
  NOT_STARTED
  SUBMITTED
  APPROVED
  REFUSED

  @@map("partner_work_permit_status")
}

enum PartnerFileKind {
  PASSPORT
  CV
  WORK_PERMIT

  @@map("partner_file_kind")
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  /// Set-password link sent to an admin account created by a super admin.
  INVITATION

  @@map("email_token_type")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

enum EducationLevel {
  NONE
  PRIMARY
  SECONDARY
  VOCATIONAL
  BACHELOR
  MASTER
  DOCTORATE

  @@map("education_level")
}

enum LanguageLevel {
  A1
  A2
  B1
  B2
  C1
  C2
  NATIVE

  @@map("language_level")
}

enum DocumentType {
  CV
  PASSPORT
  PHOTO
  DIPLOMA
  CERTIFICATE
  STCW
  SEAMAN_BOOK
  MEDICAL
  OTHER

  @@map("document_type")
}

/// Why a job is Closed (ADR-025): a recruiter, its deadline, or every position filled.
enum JobCloseReason {
  MANUAL
  DEADLINE_PASSED
  POSITIONS_FILLED

  @@map("job_close_reason")
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED

  @@map("job_status")
}

enum SalaryPeriod {
  HOUR
  DAY
  WEEK
  MONTH
  YEAR

  @@map("salary_period")
}

/// Figures from before the platform. Same values as HISTORICAL_METRICS in packages/shared.
enum HistoricalMetric {
  VISAS_APPROVED
  CANDIDATES_DEPLOYED
  CANDIDATES_REGISTERED
  PARTNER_COMPANIES
  COUNTRIES_SERVED
}

enum EmailStatus {
  /// Waiting to be sent, or to be tried again after a failure.
  PENDING
  SENT
  /// Given up after too many attempts.
  FAILED
  /// Withdrawn before it was sent (the change it announced was undone).
  CANCELLED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFER
  CONTRACT_SIGNED
  VISA_PROCESSING
  VISA_APPROVED
  DEPLOYED
  REJECTED
  WITHDRAWN

  @@map("application_status")
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

model User {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Always stored in lower case (CHECK constraint).
  email                  String    @unique
  /// argon2id hash. Null until an invited admin has set a password.
  passwordHash           String?   @map("password_hash")
  role                   UserRole  @default(CANDIDATE)
  emailVerifiedAt        DateTime? @map("email_verified_at") @db.Timestamptz(3)
  isActive               Boolean   @default(true) @map("is_active")
  lastLoginAt            DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// When the "your account will be erased" email was sent (data retention); cleared by any new activity.
  retentionWarnedAt      DateTime? @map("retention_warned_at") @db.Timestamptz(3)
  /// Language of the emails sent to the user: en, fr or ar, or pl for a PARTNER (CHECK constraint).
  locale                 String    @default("en") @db.VarChar(2)
  /// Name shown to the other members of a partner space (ADR-027). Optional for staff, who
  /// are shown by their address without one.
  displayName            String?   @map("display_name") @db.VarChar(80)
  /// Consecutive failed logins; reset by a successful login or a password reset.
  failedLoginCount       Int       @default(0) @map("failed_login_count")
  /// Logins are refused until this time (set after too many failures).
  lockedUntil            DateTime? @map("locked_until") @db.Timestamptz(3)
  /// Copied into access tokens; incrementing it invalidates every token already issued.
  tokenVersion           Int       @default(0) @map("token_version")
  /// COUNTRY_AGENT: ISO 3166-1 alpha-2 nationalities of the candidates he follows (ADR-024).
  /// Non-empty for an agent, empty for every other role (CHECK constraint).
  assignedCountries      String[]  @default([]) @map("assigned_countries")
  /// Set when a super admin chose the password: only a password change is allowed until then.
  passwordChangeRequired Boolean   @default(false) @map("password_change_required")
  /// Emails with a verification or reset link sent to this address (abuse limit, audit H2):
  /// the last one, and how many since the start of the current 24-hour window.
  emailLinkLastAt        DateTime? @map("email_link_last_at") @db.Timestamptz(3)
  emailLinkCount         Int       @default(0) @map("email_link_count")
  emailLinkWindowStart   DateTime? @map("email_link_window_start") @db.Timestamptz(3)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens    RefreshToken[]
  emailTokens      EmailToken[]
  candidateProfile CandidateProfile?
  createdJobs      Job[]
  statusChanges    ApplicationStatusHistory[]
  applicationNotes ApplicationNote[]
  auditLogs        AuditLog[]

  partnerMemberships   PartnerSpaceMember[] @relation("PartnerMember")
  partnerMembersAdded  PartnerSpaceMember[] @relation("PartnerMemberAddedBy")
  partnerSpacesCreated PartnerSpace[]
  partnerJobsCreated   PartnerJob[]         @relation("PartnerJobCreatedBy")
  partnerJobsUpdated   PartnerJob[]         @relation("PartnerJobUpdatedBy")
  partnerAppsCreated   PartnerApplication[] @relation("PartnerApplicationCreatedBy")
  partnerAppsUpdated   PartnerApplication[] @relation("PartnerApplicationUpdatedBy")
  partnerFilesUploaded PartnerFile[]
  partnerComments      PartnerComment[]
  partnerHistory       PartnerHistory[]

  @@index([role])
  /// Lists and counters select accounts by role, leaving out the erased ones.
  @@index([role, deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Tokens issued by successive rotations of one login share a family; reuse of a rotated token revokes it all.
  familyId  String    @map("family_id") @db.Uuid
  /// SHA-256 of the token; the token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  ip        String?   @db.Inet
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailToken {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  /// SHA-256 of the token; the token itself is never stored.
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?      @map("used_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

// ---------------------------------------------------------------------------
// Candidates
// ---------------------------------------------------------------------------

/// Only the names are required at creation; the API checks that the profile is
/// complete (and the passport valid) when the candidate applies.
model CandidateProfile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Identity
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  gender             Gender?
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  /// ISO 3166-1 alpha-2.
  nationality        String?   @db.Char(2)
  /// ISO 3166-1 alpha-2.
  countryOfResidence String?   @map("country_of_residence") @db.Char(2)
  city               String?
  /// E.164, with country code.
  phone              String?
  whatsapp           String?

  // Passport
  /// AES-256-GCM payload (src/common/crypto/field-cipher.ts). Never logged, never returned in lists.
  passportNumberEncrypted String?   @map("passport_number_encrypted")
  /// Last characters only, for lists and snapshots.
  passportNumberMasked    String?   @map("passport_number_masked")
  /// ISO 3166-1 alpha-2.
  passportIssuingCountry  String?   @map("passport_issuing_country") @db.Char(2)
  passportIssueDate       DateTime? @map("passport_issue_date") @db.Date
  passportExpiryDate      DateTime? @map("passport_expiry_date") @db.Date

  // Experience and education
  currentProfession        String?         @map("current_profession")
  yearsOfExperience        Int?            @map("years_of_experience") @db.SmallInt
  educationLevel           EducationLevel? @map("education_level")
  /// Licence categories such as "B", "C", "CE".
  drivingLicenceCategories String[]        @default([]) @map("driving_licence_categories")

  /// Destination codes the candidate is interested in; used to recommend jobs.
  preferredDestinations String[] @default([]) @map("preferred_destinations")

  // Cruise-ship extras
  hasStcwTraining       Boolean @default(false) @map("has_stcw_training")
  hasSeamanBook         Boolean @default(false) @map("has_seaman_book")
  hasMedicalCertificate Boolean @default(false) @map("has_medical_certificate")
  seaExperience         String? @map("sea_experience")

  /// Date the candidate accepted the data-processing notice.
  gdprConsentAt DateTime? @map("gdpr_consent_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  languages    CandidateLanguage[]
  documents    Document[]
  applications Application[]

  @@index([lastName, firstName])
  @@index([passportExpiryDate])
  /// Country agents see the candidates of their nationalities (ADR-024).
  @@index([nationality])
  @@map("candidate_profiles")
}

model CandidateLanguage {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String        @map("candidate_id") @db.Uuid
  /// ISO 639-1 code: en, fr, ar, it, pl, de...
  language    String        @db.VarChar(8)
  level       LanguageLevel
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, language])
  @@map("candidate_languages")
}

model Document {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId  String       @map("candidate_id") @db.Uuid
  type         DocumentType
  /// Path inside the private blob container.
  blobPath     String       @unique @map("blob_path")
  originalName String       @map("original_name")
  mimeType     String       @map("mime_type")
  sizeBytes    Int          @map("size_bytes")
  /// Hex digest of the file content.
  sha256       String       @db.Char(64)
  uploadedAt   DateTime     @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  candidate    CandidateProfile      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applications ApplicationDocument[]

  @@index([candidateId, type])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

/// A table, not an enum, so admins can add countries.
model Destination {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable code: MALTA, POLAND, CRUISE_SHIP...
  code      String   @unique
  /// { "en": "...", "fr": "...", "ar": "..." }
  name      Json
  /// Flag emoji or icon name.
  icon      String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  jobs              Job[]
  successStories    SuccessStory[]
  homeSlides        HomeSlide[]
  historicalFigures HistoricalFigure[]

  @@map("destinations")
}

model JobCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  /// { "en": "...", "fr": "...", "ar": "..." }
  name      Json
  icon      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  jobs Job[]

  @@map("job_categories")
}

model Job {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  slug             String  @unique
  destinationId    String  @map("destination_id") @db.Uuid
  categoryId       String  @map("category_id") @db.Uuid
  employerName     String? @map("employer_name")
  /// When false the employer name is never sent to the public site.
  showEmployerName Boolean @default(false) @map("show_employer_name")
  description      String
  requirements     String?

  // Benefits
  accommodationProvided Boolean @default(false) @map("accommodation_provided")
  transportProvided     Boolean @default(false) @map("transport_provided")
  mealsProvided         Boolean @default(false) @map("meals_provided")
  benefits              String?

  // Conditions
  salaryMin              Decimal?      @map("salary_min") @db.Decimal(10, 2)
  salaryMax              Decimal?      @map("salary_max") @db.Decimal(10, 2)
  /// ISO 4217.
  salaryCurrency         String?       @map("salary_currency") @db.Char(3)
  salaryPeriod           SalaryPeriod? @map("salary_period")
  contractDurationMonths Int?          @map("contract_duration_months") @db.SmallInt
  workingHours           String?       @map("working_hours")
  positions              Int           @default(1)
  /// Applications at Contract signed or later (ADR-025); the job closes when it equals `positions`.
  hiredCount             Int           @default(0) @map("hired_count")
  /// ISO 639-1 codes.
  requiredLanguages      String[]      @default([]) @map("required_languages")
  /// Application deadline; the job no longer accepts applications once it has passed.
  deadline               DateTime      @db.Timestamptz(3)
  coverImagePath         String?       @map("cover_image_path")
  /// Questions asked when applying: [{ id, type, required, label, options }] (see packages/shared).
  questions              Json          @default("[]")

  status      JobStatus       @default(DRAFT)
  featured    Boolean         @default(false)
  createdById String          @map("created_by_id") @db.Uuid
  publishedAt DateTime?       @map("published_at") @db.Timestamptz(3)
  closedAt    DateTime?       @map("closed_at") @db.Timestamptz(3)
  /// Why the job is Closed; a job closed for POSITIONS_FILLED reopens by itself (ADR-025).
  closeReason JobCloseReason? @map("close_reason")
  /// Soft delete: the row is kept for history and existing applications.
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Full-text search column, maintained by PostgreSQL: the migration declares it
  /// GENERATED ALWAYS AS (...) STORED. The expression is repeated here as a default, in the
  /// exact form PostgreSQL stores it, only so that Prisma sees no drift. Changing it needs a
  /// hand-written migration (drop and re-create the column).
  searchVector Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('simple'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, COALESCE(description, ''::text)), 'B'::\"char\"))")) @map("search_vector")

  destination        Destination            @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  category           JobCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy          User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  applications       Application[]
  alertNotifications JobAlertNotification[]

  @@index([status, destinationId, categoryId, deadline])
  @@index([destinationId])
  @@index([categoryId])
  @@index([createdById])
  @@index([requiredLanguages], type: Gin)
  @@index([searchVector], type: Gin)
  /// Trigram index (pg_trgm): tolerant search on the title, so "welders" or "reciptionist" still match.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "jobs_title_trgm_idx")
  @@map("jobs")
}

// ---------------------------------------------------------------------------
// Applications
// ---------------------------------------------------------------------------

/// Not unique on (candidate, job): a candidate may apply again after the cooldown.
model Application {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId            String            @map("job_id") @db.Uuid
  candidateId      String            @map("candidate_id") @db.Uuid
  status           ApplicationStatus @default(SUBMITTED)
  coverLetter      String?           @map("cover_letter")
  /// Answers to job-specific questions, keyed by question id.
  answers          Json?
  /// The questions of the job as they were when applying, so later edits do not change what was asked.
  questions        Json?
  /// Candidate profile as it was when applying. Holds the masked passport number only.
  profileSnapshot  Json              @map("profile_snapshot")
  appliedAt        DateTime          @default(now()) @map("applied_at") @db.Timestamptz(3)
  withdrawnAt      DateTime?         @map("withdrawn_at") @db.Timestamptz(3)
  /// A super admin lifted the re-application waiting period of this application (reason in the audit log).
  cooldownWaivedAt DateTime?         @map("cooldown_waived_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  job            Job                        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  candidate      CandidateProfile           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  documents      ApplicationDocument[]
  statusHistory  ApplicationStatusHistory[]
  notes          ApplicationNote[]
  successStories SuccessStory[]

  /// Serves the re-application cooldown lookup: last application of a candidate to a job.
  @@index([candidateId, jobId, appliedAt(sort: Desc)])
  /// The back-office list and the dashboard read the newest applications first.
  @@index([appliedAt(sort: Desc)])
  @@index([jobId, status])
  @@index([status])
  @@map("applications")
}

/// Candidate documents attached to an application.
model ApplicationDocument {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([applicationId, documentId])
  @@index([documentId])
  @@map("application_documents")
}

/// Append-only: one row per status change.
model ApplicationStatusHistory {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId      String             @map("application_id") @db.Uuid
  /// Null for the first row (submission).
  fromStatus         ApplicationStatus? @map("from_status")
  toStatus           ApplicationStatus  @map("to_status")
  /// Null when the author's account was deleted.
  changedById        String?            @map("changed_by_id") @db.Uuid
  /// Internal remark of the recruiter. Never shown to the candidate.
  comment            String?
  /// Optional text for the candidate: shown in their timeline and included in the email.
  messageToCandidate String?            @map("message_to_candidate")
  /// The email about this change in the outbox; its status says whether the candidate received it.
  emailId            String?            @map("email_id") @db.Uuid
  /// Insertion order. Two changes can carry the same timestamp; this number tells which came last.
  seq                Int                @default(autoincrement())
  /// Set when the author undid this change. A reverted row is kept for the record but no longer counts.
  revertedAt         DateTime?          @map("reverted_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)
  email       EmailOutbox? @relation(fields: [emailId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([emailId])
  @@index([changedById])
  @@map("application_status_history")
}

/// Internal note. Never returned to candidates.
model ApplicationNote {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  authorId      String   @map("author_id") @db.Uuid
  body          String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([authorId])
  @@map("application_notes")
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model SuccessStory {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName           String    @map("first_name")
  lastName            String    @default("") @map("last_name")
  /// False: the site shows the first name and the initial of the last name. True needs the candidate's consent to the full name.
  showFullName        Boolean   @default(false) @map("show_full_name")
  photoPath           String?   @map("photo_path")
  jobTitle            String    @map("job_title")
  destinationId       String    @map("destination_id") @db.Uuid
  visaApprovedAt      DateTime? @map("visa_approved_at") @db.Date
  /// { "en": "...", "fr": "...", "ar": "..." }
  quote               Json
  /// Blob path of the signed consent. Required before publishing (CHECK constraint).
  consentDocumentPath String?   @map("consent_document_path")
  isPublished         Boolean   @default(false) @map("is_published")
  sortOrder           Int       @default(0) @map("sort_order")
  applicationId       String?   @map("application_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  destination Destination  @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([isPublished, sortOrder])
  @@index([destinationId])
  @@index([applicationId])
  @@map("success_stories")
}

model HomeSlide {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// { "en": "...", "fr": "...", "ar": "..." }
  title         Json
  /// { "en": "...", "fr": "...", "ar": "..." }
  subtitle      Json?
  /// Null until an image is uploaded; a slide without image cannot be active (CHECK constraint).
  imagePath     String?  @map("image_path")
  /// { "en": "...", "fr": "...", "ar": "..." }
  ctaLabel      Json?    @map("cta_label")
  ctaUrl        String?  @map("cta_url")
  destinationId String?  @map("destination_id") @db.Uuid
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@index([destinationId])
  @@map("home_slides")
}

model JobAlertSubscription {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Lower case (CHECK constraint).
  email            String
  /// Destination ids to match; empty means any.
  destinationIds   String[]  @default([]) @map("destination_ids") @db.Uuid
  /// Category ids to match; empty means any.
  categoryIds      String[]  @default([]) @map("category_ids") @db.Uuid
  /// Null until the address is confirmed (double opt-in); no alert is sent before.
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz(3)
  unsubscribeToken String    @unique @map("unsubscribe_token")
  /// SHA-256 of the confirmation token of the double opt-in; null once confirmed.
  confirmTokenHash String?   @unique @map("confirm_token_hash")
  /// Language of the alert emails.
  locale           String    @default("en") @db.VarChar(2)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  notifications JobAlertNotification[]

  @@index([email])
  @@map("job_alert_subscriptions")
}

/// One row per (subscription, job) already announced, so a job is never sent twice to the same person.
model JobAlertNotification {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  jobId          String   @map("job_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription JobAlertSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  job          Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, jobId])
  @@index([jobId])
  @@map("job_alert_notifications")
}

model ContactMessage {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  ip        String?   @db.Inet
  /// Set when an admin has dealt with the message.
  handledAt DateTime? @map("handled_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([handledAt, createdAt])
  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

/// Global settings edited by the super admin, e.g. REAPPLY_COOLDOWN_MONTHS = 6.
model Setting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

/// Append-only. `before` and `after` must not contain clear passport numbers or password hashes.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null for system actions or when the actor's account was deleted.
  actorId    String?  @map("actor_id") @db.Uuid
  /// Dotted verb, e.g. "job.publish".
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?  @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Results the agency obtained before this platform existed, entered by the super admin.
/// Kept apart from applications: nothing here is ever counted as platform data.
/// One row per (year, destination, metric); the two global metrics have neither year nor
/// destination. Uniqueness (NULLs counted as equal) and the value rules are in the migration.
model HistoricalFigure {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metric        HistoricalMetric
  year          Int?             @db.SmallInt
  destinationId String?          @map("destination_id") @db.Uuid
  value         Int
  note          String?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  /// Created by hand in the migration with NULLS NOT DISTINCT; declared here so Prisma sees no drift.
  @@unique([metric, year, destinationId], map: "historical_figures_metric_year_destination_key")
  @@index([destinationId])
  @@map("historical_figures")
}

/// Emails waiting to be sent. A request only writes a row here; the task runner sends
/// them, and tries again later when the mail server is down, so no email is lost and
/// no request waits for SMTP.
model EmailOutbox {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template      String
  locale        String
  /// Recipient, variables of the template and reply address, encrypted (AES-256-GCM): the
  /// variables hold one-time links. Emptied once the email is sent.
  payload       String
  status        EmailStatus @default(PENDING)
  /// 1 account access (verification, password reset, invitation), 2 applications, 3 bulk
  /// (job alerts, recruiter notices). Lower first: the mail quota goes to what matters.
  priority      Int         @default(2) @db.SmallInt
  attempts      Int         @default(0)
  /// Not before this moment. Also the lease of an attempt in progress.
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  /// Kind of the last failure (an error name, never a message with an address).
  lastError     String?     @map("last_error")
  sentAt        DateTime?   @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  statusChanges ApplicationStatusHistory[]

  /// The sender asks for "pending and due", most urgent first, then oldest first.
  @@index([status, nextAttemptAt])
  @@index([status, priority, nextAttemptAt])
  /// The job-alert cap counts the alerts sent in the last hour.
  @@index([template, sentAt])
  @@map("email_outbox")
}

/// Addresses Azure reported as undeliverable: a hard bounce, or an address Azure itself
/// suppresses. Only the SHA-256 of the lower-case address is kept; nothing is sent to it
/// again (audit M2). Removed RETENTION_MONTHS after the last report.
model EmailSuppression {
  /// SHA-256 of the lower-case address, hexadecimal (CHECK constraint).
  emailHash   String   @id @map("email_hash") @db.Char(64)
  /// BOUNCED or SUPPRESSED, the status of Azure's last delivery report (CHECK constraint).
  reason      String   @db.VarChar(16)
  lastEventAt DateTime @map("last_event_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([lastEventAt])
  @@map("email_suppressions")
}

// ---------------------------------------------------------------------------
// Partner spaces (ADR-027): a private workspace per partner company. Nothing here is
// linked to jobs, applications, candidates or documents of the public site. Every child row
// carries partner_space_id, and its foreign keys to its parents include it, so the database
// refuses a row of one space attached to a parent of another.
// ---------------------------------------------------------------------------

model PartnerSpace {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique ignoring case (index on lower(name), hand-written).
  name          String   @db.VarChar(120)
  /// ISO 3166-1 alpha-2 (CHECK constraint).
  country       String   @db.Char(2)
  /// en, fr or pl (CHECK constraint): the partner area and the partner logins' emails.
  defaultLocale String   @map("default_locale") @db.VarChar(2)
  /// Path of the logo in the private partner-files container.
  logoPath      String?  @map("logo_path")
  /// False: no member can open the space until it is enabled again.
  isActive      Boolean  @default(true) @map("is_active")
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy    User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members      PartnerSpaceMember[]
  jobs         PartnerJob[]
  applications PartnerApplication[]
  files        PartnerFile[]
  comments     PartnerComment[]
  history      PartnerHistory[]

  @@map("partner_spaces")
}

model PartnerSpaceMember {
  partnerSpaceId String            @map("partner_space_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  /// PARTNER if and only if the user's role is PARTNER (checked by the service).
  kind           PartnerMemberKind
  addedById      String?           @map("added_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  space   PartnerSpace @relation(fields: [partnerSpaceId], references: [id], onDelete: Cascade)
  user    User         @relation("PartnerMember", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User?        @relation("PartnerMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  // A partner login belongs to one space: partial unique index on user_id where kind = PARTNER (hand-written).
  @@id([partnerSpaceId, userId])
  @@index([userId])
  @@map("partner_space_members")
}

/// A job demand of the partner company.
model PartnerJob {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerSpaceId String           @map("partner_space_id") @db.Uuid
  role           String           @db.VarChar(120)
  /// More than 0 (CHECK constraint).
  positions      Int
  /// 1 to 10 places (CHECK constraint).
  locations      String[]
  salary         String?          @db.VarChar(200)
  /// Plain text, never HTML.
  description    String           @default("") @db.VarChar(5000)
  status         PartnerJobStatus @default(OPEN)
  /// Set if and only if status is CLOSED (CHECK constraint).
  closedAt       DateTime?        @map("closed_at") @db.Timestamptz(3)
  createdById    String?          @map("created_by_id") @db.Uuid
  updatedById    String?          @map("updated_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  space        PartnerSpace         @relation(fields: [partnerSpaceId], references: [id], onDelete: Cascade)
  createdBy    User?                @relation("PartnerJobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?                @relation("PartnerJobUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  applications PartnerApplication[]
  comments     PartnerComment[]

  @@unique([partnerSpaceId, id])
  @@index([partnerSpaceId, status, createdAt])
  @@map("partner_jobs")
}

/// A person put forward for a job demand, and the follow-up of their visa.
model PartnerApplication {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerSpaceId          String                  @map("partner_space_id") @db.Uuid
  partnerJobId            String                  @map("partner_job_id") @db.Uuid
  firstName               String                  @map("first_name") @db.VarChar(100)
  lastName                String                  @map("last_name") @db.VarChar(100)
  /// ISO 3166-1 alpha-2 (CHECK constraint).
  nationality             String                  @db.Char(2)
  /// E.164 (CHECK constraint).
  phone                   String?                 @db.VarChar(16)
  /// Lower case (CHECK constraint). Nothing is ever emailed to it.
  email                   String?                 @db.VarChar(254)
  workPermitStatus        PartnerWorkPermitStatus @default(NOT_STARTED) @map("work_permit_status")
  workPermitSubmittedDate DateTime?               @map("work_permit_submitted_date") @db.Date
  /// Only when the work permit is APPROVED or REFUSED (CHECK constraint).
  workPermitDecisionDate  DateTime?               @map("work_permit_decision_date") @db.Date
  visaStatus              PartnerVisaStatus       @default(NOT_STARTED) @map("visa_status")
  visaAppointmentDate     DateTime?               @map("visa_appointment_date") @db.Date
  /// Only when the visa is APPROVED or REFUSED (CHECK constraint).
  visaDecisionDate        DateTime?               @map("visa_decision_date") @db.Date
  dhlSentDate             DateTime?               @map("dhl_sent_date") @db.Date
  /// Only with dhl_sent_date (CHECK constraint).
  dhlTrackingNumber       String?                 @map("dhl_tracking_number") @db.VarChar(40)
  documentsReceivedDate   DateTime?               @map("documents_received_date") @db.Date
  createdById             String?                 @map("created_by_id") @db.Uuid
  updatedById             String?                 @map("updated_by_id") @db.Uuid
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  space     PartnerSpace     @relation(fields: [partnerSpaceId], references: [id], onDelete: Cascade)
  job       PartnerJob       @relation(fields: [partnerSpaceId, partnerJobId], references: [partnerSpaceId, id], onDelete: Cascade)
  createdBy User?            @relation("PartnerApplicationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?            @relation("PartnerApplicationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  files     PartnerFile[]
  comments  PartnerComment[]
  history   PartnerHistory[]

  @@unique([partnerSpaceId, id])
  @@index([partnerSpaceId, partnerJobId])
  @@index([partnerSpaceId, visaStatus])
  @@index([partnerSpaceId, workPermitStatus])
  @@map("partner_applications")
}

/// The current passport, CV or work permit of an application; a new upload replaces it.
model PartnerFile {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerSpaceId       String          @map("partner_space_id") @db.Uuid
  partnerApplicationId String          @map("partner_application_id") @db.Uuid
  kind                 PartnerFileKind
  /// Format detected from the content (inspectDocument).
  format               String          @db.VarChar(10)
  mimeType             String          @map("mime_type") @db.VarChar(100)
  /// More than 0 (CHECK constraint).
  sizeBytes            Int             @map("size_bytes")
  sha256               String          @db.Char(64)
  /// spaces/<spaceId>/<random> in the private partner-files container.
  storagePath          String          @unique @map("storage_path")
  originalName         String          @map("original_name") @db.VarChar(255)
  uploadedById         String?         @map("uploaded_by_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  space       PartnerSpace       @relation(fields: [partnerSpaceId], references: [id], onDelete: Cascade)
  application PartnerApplication @relation(fields: [partnerSpaceId, partnerApplicationId], references: [partnerSpaceId, id], onDelete: Cascade)
  uploadedBy  User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([partnerApplicationId, kind])
  @@index([partnerSpaceId])
  @@map("partner_files")
}

/// Append-only: no editing (ADR-027, answer 3); deleted with its application or space.
model PartnerComment {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerSpaceId       String   @map("partner_space_id") @db.Uuid
  /// Exactly one of the job demand and the application (CHECK constraint).
  partnerJobId         String?  @map("partner_job_id") @db.Uuid
  partnerApplicationId String?  @map("partner_application_id") @db.Uuid
  authorId             String?  @map("author_id") @db.Uuid
  /// The author's name when the comment was written.
  authorName           String   @map("author_name") @db.VarChar(254)
  /// Plain text, never HTML.
  body                 String   @db.VarChar(2000)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  space       PartnerSpace        @relation(fields: [partnerSpaceId], references: [id], onDelete: Cascade)
  job         PartnerJob?         @relation(fields: [partnerSpaceId, partnerJobId], references: [partnerSpaceId, id], onDelete: Cascade)
  application PartnerApplication? @relation(fields: [partnerSpaceId, partnerApplicationId], references: [partnerSpaceId, id], onDelete: Cascade)
  author      User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([partnerSpaceId, partnerJobId, createdAt])
  @@index([partnerSpaceId, partnerApplicationId, createdAt])
  @@map("partner_comments")
}

/// Append-only history of every change in a space: who, what, when, old and new value.
model PartnerHistory {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerSpaceId       String   @map("partner_space_id") @db.Uuid
  actorId              String?  @map("actor_id") @db.Uuid
  actorName            String   @map("actor_name") @db.VarChar(254)
  /// space, member, login, job, application, file, comment.
  entityType           String   @map("entity_type") @db.VarChar(30)
  entityId             String   @map("entity_id") @db.Uuid
  /// The application the entry is about: its rows go when it is deleted (ADR-027, rule 11).
  partnerApplicationId String?  @map("partner_application_id") @db.Uuid
  action               String   @db.VarChar(40)
  field                String?  @db.VarChar(60)
  oldValue             String?  @map("old_value") @db.VarChar(500)
  newValue             String?  @map("new_value") @db.VarChar(500)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  space       PartnerSpace        @relation(fields: [partnerSpaceId], references: [id], onDelete: Cascade)
  application PartnerApplication? @relation(fields: [partnerSpaceId, partnerApplicationId], references: [partnerSpaceId, id], onDelete: Cascade)
  actor       User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([partnerSpaceId, createdAt(sort: Desc)])
  @@index([partnerSpaceId, entityType, entityId])
  @@map("partner_history")
}
