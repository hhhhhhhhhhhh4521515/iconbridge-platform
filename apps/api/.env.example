# API configuration. Copy to apps/api/.env (git-ignored) or run `pnpm env:init`.
# Every variable is REQUIRED: the API validates them with zod at startup
# (src/config/env.ts) and refuses to start if one is missing or malformed.
# The values below match docker-compose.yml and are for local development only.

# development | test | production
NODE_ENV=development

# Port the API listens on. Swagger UI: http://localhost:4000/api/docs
PORT=4000

# Origin of the web app, allowed by CORS (scheme + host + port, no trailing slash).
WEB_ORIGIN=http://localhost:3000

# PostgreSQL connection string used by Prisma.
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / POSTGRES_PORT in the root .env.
DATABASE_URL=postgresql://iconbridge:iconbridge@localhost:5432/iconbridge?schema=public

# Outgoing email. Locally this is Mailpit (inbox at http://localhost:8025).
# In Azure use port 587: outbound port 25 is blocked.
# Must match MAILPIT_SMTP_PORT in the root .env.
SMTP_HOST=localhost
SMTP_PORT=2525

# Sender shown on platform emails.
MAIL_FROM="IconBridge Jobs <no-reply@iconbridge.local>"

# Blob storage for candidate documents. "UseDevelopmentStorage=true" is the
# Azurite shortcut (account devstoreaccount1 on localhost:10000); it is not a secret.
# In Azure the real value comes from Key Vault, never from a committed file.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Public URL of the "public-media" blob container (job cover images, later slides and
# story photos), without a trailing slash. The API creates the container at first upload.
# Locally this is Azurite; in Azure it is the storage account or CDN URL.
PUBLIC_MEDIA_BASE_URL=http://localhost:10000/devstoreaccount1/public-media

# AES-256-GCM key that encrypts passport numbers before they are stored: 32 random bytes
# in base64. `pnpm env:init` generates one; by hand: openssl rand -base64 32
# Losing or changing it makes stored passport numbers unreadable. In Azure it comes
# from Key Vault. Never reuse the local key elsewhere.
PASSPORT_ENCRYPTION_KEY=

# --- Seed only (`pnpm db:seed`); not read by the running API ---
# First super admin, created if no user has this email. An existing account is never changed.
SEED_ADMIN_EMAIL=admin@iconbridge.local
# At least 12 characters. `pnpm env:init` generates one; read it in apps/api/.env.
# In development the 5 fake candidates (candidate1@example.test ...) get the same password.
SEED_ADMIN_PASSWORD=

# --- Authentication ---
# Signs the 15-minute access tokens (HS256). At least 32 characters.
# `pnpm env:init` generates one; by hand: openssl rand -base64 48
# Changing it signs everybody out. In Azure it comes from Key Vault.
JWT_ACCESS_SECRET=

# Cloudflare Turnstile secret, checked on registration.
# The value below is Cloudflare's public test secret: it accepts every token, and outside
# production the API then skips the call to Cloudflare, so registration works offline.
# The API refuses to start in production with a test secret.
# Use a real secret (Key Vault) in Azure.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# SMTP credentials. Empty for Mailpit; set both for a real provider (port 587, STARTTLS).
SMTP_USER=
SMTP_PASSWORD=

# Number of reverse proxies in front of the API. Client IP addresses (rate limits,
# audit log) are read from X-Forwarded-For only when this is above 0.
# 0 locally; 1 behind the Azure Container Apps ingress.
TRUST_PROXY_HOPS=0
