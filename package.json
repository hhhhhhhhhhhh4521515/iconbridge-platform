{
  "name": "iconbridge-platform",
  "version": "0.1.0",
  "private": true,
  "description": "IconBridge Jobs - recruitment platform for jobs in Malta, Poland and on cruise ships",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "node scripts/dev-preflight.mjs && pnpm infra:up && turbo run dev --output-logs=full",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:browser": "pnpm --filter @iconbridge/web test:browser",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "env:init": "node scripts/env-init.mjs",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @iconbridge/api db:migrate",
    "db:seed": "pnpm --filter @iconbridge/shared build && pnpm --filter @iconbridge/api db:seed",
    "api:types": "pnpm --filter @iconbridge/api openapi:export && pnpm --filter @iconbridge/shared api:types",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@iconbridge/config": "workspace:*",
    "eslint": "catalog:",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7"
  }
}
