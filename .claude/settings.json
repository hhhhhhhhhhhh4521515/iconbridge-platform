{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform init:*)",
      "Bash(tflint:*)",
      "Bash(checkov:*)",
      "Bash(trivy:*)",
      "Bash(az account show:*)",
      "Bash(az account list:*)",
      "Bash(az version:*)",
      "Bash(az * list:*)",
      "Bash(az * show:*)",
      "Bash(az * list-usage:*)",
      "Bash(az * list-skus:*)"
    ],
    "ask": [
      "Bash(docker compose down -v:*)",
      "Bash(docker compose down --volumes:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker system prune:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform * apply:*)",
      "Bash(terraform * destroy:*)",
      "Bash(az group delete:*)",
      "Bash(az * delete:*)",
      "Bash(az * purge:*)",
      "Bash(make tf-bootstrap:*)",
      "Bash(make tf-apply:*)",
      "Bash(make tf-destroy:*)",
      "Bash(az * create:*)",
      "Bash(az * update:*)",
      "Bash(az * set:*)",
      "Bash(az * add:*)",
      "Bash(az * remove:*)",
      "Bash(az * register:*)",
      "Bash(az * unregister:*)",
      "Bash(az * start:*)",
      "Bash(az * stop:*)",
      "Bash(az * restart:*)",
      "Bash(az * bind:*)",
      "Bash(az * unbind:*)",
      "Bash(az * import:*)",
      "Bash(az * recover:*)",
      "Bash(az * assign:*)",
      "Bash(az * login:*)",
      "Bash(az acr build:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf ..:*)",
      "Bash(rm -fr /:*)",
      "Bash(rm -fr ~:*)",
      "Bash(rm -fr ..:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force:*)",
      "Bash(git push * -f:*)",
      "Bash(git push * --force-with-lease:*)"
    ]
  }
}
