# Copy to terraform.tfvars (git-ignored) and fill in. No secret goes here: secrets are
# generated by Terraform or set in Key Vault by hand (docs/DEPLOYMENT.md).

owner_email = "you@example.com"

# az ad signed-in-user show --query id -o tsv
owner_object_id = "00000000-0000-0000-0000-000000000000"

# Your public IPv4, to reach PostgreSQL from this machine: curl -s https://api.ipify.org
admin_ip_addresses = ["203.0.113.10"]

# "acr" for the first 12 months, then "ghcr" (see docs/DEPLOYMENT.md).
registry_type = "acr"
# ghcr_owner    = "your-github-account"
# ghcr_username = "your-github-account"

# The amount and the other public settings are in production.auto.tfvars (committed).
enable_budget     = true
budget_start_date = "2026-10-01T00:00:00Z"

# Emails leave from DoNotReply@<Azure-managed domain> (Azure Communication Services).
mail_display_name = "IconBridge Recruitment"

enable_custom_domain = false
# custom_domain      = "jobs.example.com"
