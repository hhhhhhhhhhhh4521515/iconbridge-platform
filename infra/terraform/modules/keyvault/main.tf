# Secrets of the apps. Access by Azure RBAC only (no access policies):
# - the person or pipeline running Terraform writes them (Key Vault Secrets Officer);
# - the managed identity of the apps reads them (Key Vault Secrets User). Container Apps
#   reference them by id, so their values never appear in the app configuration.
#
# Two kinds of secrets:
# - generated: values made by Terraform (random), written here;
# - external: values only the owner has (SMTP, Turnstile). Created with a placeholder,
#   then set by hand with `az keyvault secret set`; Terraform never overwrites them.

# Not prevent_destroy: purge protection already keeps a deleted vault and its secrets
# recoverable for 7 days (soft_delete_retention_days).
# tflint-ignore: azurerm_resources_missing_prevent_destroy
resource "azurerm_key_vault" "this" {
  name                = "kv-iconbridge-${var.name_suffix}"
  location            = var.location
  resource_group_name = var.resource_group_name
  tenant_id           = var.tenant_id
  sku_name            = "standard"

  rbac_authorization_enabled = true
  purge_protection_enabled   = true
  soft_delete_retention_days = 7

  # The apps reach the vault from the Consumption plan, which has no fixed address or VNet.
  public_network_access_enabled = true
  network_acls {
    default_action = "Allow"
    bypass         = "AzureServices"
  }

  tags = var.tags
}

resource "azurerm_role_assignment" "deployer" {
  scope                = azurerm_key_vault.this.id
  role_definition_name = "Key Vault Secrets Officer"
  principal_id         = var.deployer_principal_id
}

resource "azurerm_role_assignment" "apps" {
  scope                = azurerm_key_vault.this.id
  role_definition_name = "Key Vault Secrets User"
  principal_id         = var.apps_principal_id
}

# Role assignments take a moment to reach Key Vault.
resource "time_sleep" "rbac" {
  create_duration = "60s"
  depends_on      = [azurerm_role_assignment.deployer, azurerm_role_assignment.apps]
}

resource "azurerm_key_vault_secret" "generated" {
  for_each = nonsensitive(toset(keys(var.generated_secrets)))

  name         = each.value
  value        = var.generated_secrets[each.value]
  key_vault_id = azurerm_key_vault.this.id
  content_type = "generated by terraform"
  depends_on   = [time_sleep.rbac]
}

resource "azurerm_key_vault_secret" "external" {
  for_each = toset(var.external_secrets)

  name         = each.value
  value        = "CHANGE_ME"
  key_vault_id = azurerm_key_vault.this.id
  content_type = "set by hand with az keyvault secret set"
  depends_on   = [time_sleep.rbac]

  lifecycle {
    # The real value is set outside Terraform and must stay.
    ignore_changes = [value, content_type]
  }
}
